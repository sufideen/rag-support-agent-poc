# Copy to .env (or export as real env vars) before running app/ingest.py or app/query.py.
# No API keys — auth is Entra ID only (disableLocalAuth=true), via `az login` +
# DefaultAzureCredential.

# Required — from the `az deployment group create` outputs.
SEARCH_ENDPOINT=https://ragcs-poc-search.search.windows.net
OPENAI_ENDPOINT=https://ragcs-poc-aoai.openai.azure.com

# Optional — defaults shown match infra/openai-model-deployments.bicep and app/config.py.
SEARCH_INDEX_NAME=gridpulse-support-kb
OPENAI_API_VERSION=2024-10-21
CHAT_DEPLOYMENT=gpt-5-mini
EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
